# Copy to .env at the repo root (both apps read it).
DATABASE_URL="postgresql://peoplepay:peoplepay@localhost:5433/peoplepay360?schema=public"
JWT_SECRET="change-me-in-production"
PORT=4000
CORS_ORIGIN="http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173"

# MailHog (docker-compose). Inbox at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="PeoplePay360 <payroll@peoplepay360.local>"
